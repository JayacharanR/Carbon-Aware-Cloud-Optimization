# Carbon Scheduler operator environment
#
# Copy this file to .env, replace every REPLACE_ME/empty value, and keep .env
# local.  Python entry points load .env automatically.  PowerShell deployment
# scripts also load it when they start.  Never commit .env or paste its secret
# values into chat.

# ---------------------------------------------------------------------------
# External credentials and service endpoints
# ---------------------------------------------------------------------------
ELECTRICITY_MAPS_API_KEY=
ELECTRICITY_MAPS_API_BASE_URL=https://api.electricitymaps.com/v4

# Use the root Ollama URL.  The code appends /api/chat and /v1 as needed.
# For an in-cluster controller this must be reachable through a private route.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_RETRY_COUNT=2

# These credentials are generated for the in-cluster platform services.
# They are not sent to a hosted Neo4j/Qdrant service.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_URI=bolt://neo4j.scheduler-system.svc.cluster.local:7687
NEO4J_DATABASE=neo4j
QDRANT_API_KEY=
QDRANT_URL=http://qdrant.scheduler-system.svc.cluster.local:6333

# ---------------------------------------------------------------------------
# Azure and cost controls
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_PRIMARY_REGION=
AZURE_SECONDARY_REGION=
AZURE_PRIMARY_CLUSTER=
AZURE_SECONDARY_CLUSTER=
AZURE_PRIMARY_DNS_PREFIX=
AZURE_SECONDARY_DNS_PREFIX=
AZURE_DEPLOYMENT_LOCATION=eastus
AZURE_KUBERNETES_VERSION=
AZURE_NODE_VM_SIZE=Standard_B2s
AZURE_NODE_COUNT=2
AZURE_MAX_PODS=30

# Supply either AZURE_SSH_PUBLIC_KEY_PATH or AZURE_SSH_PUBLIC_KEY.
# Never put a private SSH key here.
AZURE_SSH_PUBLIC_KEY_PATH=
AZURE_SSH_PUBLIC_KEY=

AZURE_BUDGET_NAME=
AZURE_BUDGET_MONTHLY_AMOUNT=
# Comma-separated addresses, for example owner@example.edu,supervisor@example.edu
AZURE_BUDGET_CONTACT_EMAILS=
AZURE_BUDGET_START_DATE=
AZURE_BUDGET_END_DATE=

# ---------------------------------------------------------------------------
# Electricity Maps capture and replay policy
# ---------------------------------------------------------------------------
CARBON_PROVIDER=azure
CARBON_PRIMARY_PROVIDER_REGION=
CARBON_SECONDARY_PROVIDER_REGION=
# Use a horizon authorized by the active Electricity Maps plan (normally 24/48/72).
CARBON_FORECAST_HORIZON_HOURS=24
CARBON_CACHE_DIRECTORY=data/carbon_cache
CARBON_CACHE_MAX_AGE_SECONDS=86400
CARBON_REPLAY_TRACE_PATH=artifacts/carbon-trace.json

# ---------------------------------------------------------------------------
# DeathStarBench workload policy
# ---------------------------------------------------------------------------
WORKLOAD_NAMESPACE=benchmark
WORKLOAD_FRONTEND_SERVICE=
WORKLOAD_BENCHMARK_SCRIPT=compose-post.lua
WORKLOAD_PROFILE_ID=
WORKLOAD_EARLIEST_START=
WORKLOAD_DEADLINE=
WORKLOAD_RESET_BEFORE_SESSION=true

SLO_PROFILE_P95_LIMIT_MS=
SLO_PROFILE_ERROR_RATE_LIMIT=

# ---------------------------------------------------------------------------
# Trust gate and deterministic MILP policy
# ---------------------------------------------------------------------------
TRUST_THRESHOLD=
TRUST_WEIGHT_RAGAS_FAITHFULNESS=
TRUST_WEIGHT_RAGAS_CONTEXT_PRECISION=
TRUST_WEIGHT_NEMO_RAILS=
TRUST_WEIGHT_DATA_FRESHNESS=
TRUST_WEIGHT_EXECUTION_FEASIBILITY=

MILP_SLOT_MINUTES=5
MILP_ALLOWED_REGIONS=
MILP_LATENCY_CATALOG_PATH=config/latency_catalog.yaml
EXPERIMENT_MODES=llm_only,milp_only,hybrid
EXPERIMENT_STATIC_REFERENCE_REGION=
EXPERIMENT_RANDOM_SEED=1

# ---------------------------------------------------------------------------
# DeathStarBench source, images, and common load profile
# ---------------------------------------------------------------------------
DEATHSTARBENCH_SOURCE=
DEATHSTARBENCH_COMMIT=
DEATHSTARBENCH_NAMESPACE=benchmark
DEATHSTARBENCH_RELEASE_NAME=social-network
DSB_TOOLS_IMAGE=
CONTROLLER_IMAGE=
CONTROLLER_COMMAND=python -m carbon_scheduler.controller

# This path is inside the dsb-tools image, not a Windows host path.
DSB_GRAPH_DATASET=
DSB_ACTIVE_DEADLINE_SECONDS=900
DSB_WRK_THREADS=2
DSB_WRK_CONNECTIONS=10
DSB_WRK_DURATION=60s
DSB_REQUESTS_PER_SECOND=10
DSB_LOADGEN_CPU_REQUEST=250m
DSB_LOADGEN_MEMORY_REQUEST=256Mi

# ---------------------------------------------------------------------------
# Regional Kubernetes target details
# ---------------------------------------------------------------------------
# For local execution use the exact values from `kubectl config get-contexts`.
# For the in-cluster controller use `in-cluster` for exactly one region.
TARGET_PRIMARY_CLUSTER_NAME=
TARGET_PRIMARY_KUBE_CONTEXT=
TARGET_PRIMARY_KUBECONFIG_PATH=
TARGET_PRIMARY_FRONTEND_SERVICE=
TARGET_PRIMARY_FRONTEND_HOST=
TARGET_PRIMARY_FRONTEND_PORT=8080
TARGET_PRIMARY_TARGET_URL=

TARGET_SECONDARY_CLUSTER_NAME=
TARGET_SECONDARY_KUBE_CONTEXT=
# For the controller this is an in-container path such as
# /var/run/scheduler/kubeconfigs/secondary-kubeconfig.
TARGET_SECONDARY_KUBECONFIG_PATH=
TARGET_SECONDARY_FRONTEND_SERVICE=
TARGET_SECONDARY_FRONTEND_HOST=
TARGET_SECONDARY_FRONTEND_PORT=8080
TARGET_SECONDARY_TARGET_URL=

# Optional per-region overrides.  Empty values fall back to the common DSB
# values above.  The generated targets.yaml always contains explicit values.
TARGET_PRIMARY_DSB_TOOLS_IMAGE=
TARGET_SECONDARY_DSB_TOOLS_IMAGE=
TARGET_PRIMARY_GRAPH_DATASET=
TARGET_SECONDARY_GRAPH_DATASET=
TARGET_PRIMARY_ACTIVE_DEADLINE_SECONDS=
TARGET_SECONDARY_ACTIVE_DEADLINE_SECONDS=
TARGET_PRIMARY_WRK_THREADS=
TARGET_SECONDARY_WRK_THREADS=
TARGET_PRIMARY_WRK_CONNECTIONS=
TARGET_SECONDARY_WRK_CONNECTIONS=
TARGET_PRIMARY_WRK_DURATION=
TARGET_SECONDARY_WRK_DURATION=
TARGET_PRIMARY_REQUESTS_PER_SECOND=
TARGET_SECONDARY_REQUESTS_PER_SECOND=
TARGET_PRIMARY_LOADGEN_CPU_REQUEST=
TARGET_SECONDARY_LOADGEN_CPU_REQUEST=
TARGET_PRIMARY_LOADGEN_MEMORY_REQUEST=
TARGET_SECONDARY_LOADGEN_MEMORY_REQUEST=

# ---------------------------------------------------------------------------
# Pilot-derived latency values
# ---------------------------------------------------------------------------
# These must be measured p95 values, not estimates.
LATENCY_PRIMARY_P95_MS=
LATENCY_SECONDARY_P95_MS=

# ---------------------------------------------------------------------------
# Controller/runtime defaults
# ---------------------------------------------------------------------------
SCHEDULER_RETRIEVAL_BACKEND=in_memory
SCHEDULER_ORCHESTRATION_BACKEND=direct
OTEL_EXPORTER_OTLP_ENDPOINT=
CONTROLLER_EXPERIMENT_MODE=hybrid
RUN_ARTIFACT_ROOT=artifacts/runs

# The registry password is intentionally not consumed by the repository.
# Authenticate with `docker login <registry>` instead of storing it here.
CONTAINER_REGISTRY=
